# Copy to supabase/functions/.env (npm run setup does this) and choose ONE option.

# Option A: Cerebras. The app was built and tuned on this one.
# CEREBRAS_API_KEY=
# CEREBRAS_REASONING_EFFORT=medium

# Option B: any OpenAI-compatible service. OpenAI is used if AI_BASE_URL is left out.
# AI_API_KEY=
# AI_MODEL=gpt-4.1-mini
# AI_BASE_URL=https://api.openai.com/v1
# Lower this if your model rejects large requests (e.g. 16384 for gpt-4o-mini).
# AI_MAX_OUTPUT_TOKENS=32768

# Optional: a Vercel AI Gateway key turns on the second allergen check (see README).
# AI_GATEWAY_API_KEY=
