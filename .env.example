# npm run setup writes .env.local for you. Only needed to use a hosted Supabase project.
# Hosted: after creating your account, turn off new sign-ups in the Supabase dashboard (every account can spend your AI key), and don't push supabase/config.toml to it.
VITE_SUPABASE_URL="https://your-project-id.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="your-publishable-key"
# Optional: send errors to your own Sentry project.
# VITE_SENTRY_DSN=
